<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\QualityVision.Core\QualityVision.Core.csproj" />
    <ProjectReference Include="..\..\src\QualityVision.Infrastructure\QualityVision.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\QualityVision.Web\QualityVision.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\models\yolo11n.onnx" Link="models\yolo11n.onnx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\models\yolo11m.onnx" Link="models\yolo11m.onnx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- ExcludeAssets does not flow to consuming projects, so it is repeated here: the CPU-only native
         libonnxruntime.so of Microsoft.ML.OnnxRuntime must not overwrite the GPU build (see ADR-004). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" ExcludeAssets="native;runtime" />
  </ItemGroup>

</Project>
