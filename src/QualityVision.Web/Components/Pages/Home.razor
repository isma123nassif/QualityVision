@page "/"
@using System.Globalization
@using QualityVision.Core.Detection
@using QualityVision.Core.Inspection
@using QualityVision.Core.Rules
@using QualityVision.Web.Pipeline
@implements IAsyncDisposable
@inject ICameraStatus CameraStatus
@inject IPipelineMetrics Metrics
@inject IInspectionLog InspectionLog
@inject TimeProvider Clock
@inject IJSRuntime JS
@inject ILogger<Home> Logger

<PageTitle>QualityVision – Prüfstation</PageTitle>

@if (_alarm is not null)
{
    <div class="alarm-banner @(_alarm.Verdict == Verdict.Danger ? "danger" : "nok")" role="alert" @key="_alarmVersion">
        @AlarmText(_alarm)
    </div>
}

<section class="kpi-bar" aria-label="Kennzahlen">
    <div class="counters" aria-label="Zähler">
        <div class="counter ok"><span class="label">i.O.</span><span class="value">@_counts.Ok</span></div>
        <div class="counter nok"><span class="label">n.i.O.</span><span class="value">@_counts.Nok</span></div>
        <div class="counter danger"><span class="label">Gefahr</span><span class="value">@_counts.Danger</span></div>
        <div class="counter unknown"><span class="label">Unbekannt</span><span class="value">@_counts.Unknown</span></div>
        <div class="counter rate" title="n.i.O. / (i.O. + n.i.O.)"><span class="label">Ausschussquote</span><span class="value">@((_counts.ScrapRate * 100).ToString("0.0", De)) %</span><span class="sub">n.i.O. / (i.O. + n.i.O.)</span></div>
        <div class="counter metric"><span class="label">FPS</span><span class="value">@_procFps.ToString("0.0", De)</span></div>
        <div class="counter metric"><span class="label">Inferenz ms</span><span class="value">@_inferenceMs.ToString("0.0", De)</span></div>
        <div class="counter metric">
            <span class="label">Erkennung</span>
            <span class="device-badge @(_isGpu ? "gpu" : "cpu")">@_deviceText</span>
        </div>
    </div>
    <button type="button" class="sound-toggle @(_soundOn ? "on" : "off")" @onclick="ToggleSoundAsync" aria-pressed="@(_soundOn ? "true" : "false")">
        @(_soundOn ? "🔔 Ton an" : "🔕 Ton aus")
    </button>
</section>

<main class="dash">
    <section class="live" aria-label="Livebild">
        <div class="live-frame">
            <img src="/stream" alt="Livebild der Prüfstation" />
        </div>

        <h2 class="panel-title">Prüfungen pro Minute</h2>
        <PerMinuteChart Buckets="_buckets" />

        <h2 class="panel-title">Ereignisprotokoll</h2>
        @if (_recent.Count == 0)
        {
            <p class="muted recent-empty">Noch keine Prüfungen</p>
        }
        else
        {
            <ul class="recent-list event-log">
                @foreach (var e in _recent)
                {
                    <li @key="e.Sequence" class="@(IsFresh(e) ? "fresh" : null)">
                        <span class="recent-time">@e.Timestamp.ToLocalTime().ToString("HH:mm:ss", De)</span>
                        <span class="recent-name">@e.DisplayName</span>
                        <span class="verdict @VerdictClass(e.Verdict)">@VerdictLabels.Get(e.Verdict)</span>
                        <span class="det-conf">@e.Confidence.ToString("P0", De)</span>
                    </li>
                }
            </ul>
        }
    </section>

    <aside class="status" aria-label="Kamerastatus">
        <h2>Kamerastatus</h2>

        <div class="tile">
            <span class="label">Quelle</span>
            <span class="value value-text">@_sourceName</span>
        </div>

        <div class="tile">
            <span class="label">Verbindung</span>
            @if (_connected)
            {
                <span class="value badge ok">● Verbunden</span>
            }
            else
            {
                <span class="value badge nok">● Getrennt</span>
            }
        </div>

        <div class="tile">
            <span class="label">Eingangs-FPS</span>
            <span class="value">@_fps.ToString("0.0", De)</span>
        </div>

        <div class="tile">
            <span class="label">Letztes Bild</span>
            <span class="value">@_lastFrameText</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(_lastError))
        {
            <p class="error-text">Fehler: @_lastError</p>
        }

        <h2 class="panel-title">Verarbeitung</h2>

        <div class="tile">
            <span class="label">Erkannt</span>
            <span class="value">@_detectionTotal</span>
        </div>

        <div class="tile">
            <span class="label">Erkannte Objekte</span>
            @if (_detections.Count == 0)
            {
                <span class="value-text muted">Keine Objekte</span>
            }
            else
            {
                <ul class="det-list">
                    @foreach (var d in _detections)
                    {
                        <li><span>@GermanLabels.Get(d.Detection.ClassName)</span><span class="verdict @VerdictClass(d.Verdict)">@VerdictLabels.Get(d.Verdict)</span><span class="det-conf">@d.Detection.Confidence.ToString("P0", De)</span></li>
                    }
                </ul>
            }
        </div>
    </aside>
</main>

@code {
    private const int LogSize = 50;
    private const int ChartMinutes = 15;
    private const int ChartRefreshTicks = 10; // metrics timer ticks (1 s) between chart refreshes: the window slides
    private static readonly TimeSpan AlarmDuration = TimeSpan.FromSeconds(4);
    private static readonly TimeSpan FreshDuration = TimeSpan.FromSeconds(3);
    // Events are coalesced: at most one UI refresh per 250 ms (~4 Hz), however many objects enter at once.
    private static readonly TimeSpan EventFlushDelay = TimeSpan.FromMilliseconds(250);
    private static readonly CultureInfo De = CultureInfo.GetCultureInfo("de-DE");

    private readonly CancellationTokenSource _cts = new();
    private readonly Lock _pendingGate = new();
    private InspectionEvent? _pendingAlarm; // guarded by _pendingGate
    private int _flushScheduled;            // 0/1, Interlocked
    private volatile bool _disposed;

    private IJSObjectReference? _alarmModule;
    private bool _soundOn;
    private InspectionEvent? _alarm;
    private int _alarmVersion;

    private string _sourceName = "–";
    private bool _connected;
    private double _fps;
    private string _lastFrameText = "–";
    private string? _lastError;
    private double _procFps;
    private double _inferenceMs;
    private IReadOnlyList<ClassifiedDetection> _detections = [];
    private int _detectionTotal;
    private InspectionCounts _counts;
    private IReadOnlyList<InspectionEvent> _recent = [];
    private IReadOnlyList<MinuteBucket> _buckets = [];
    private bool _isGpu;
    private string _deviceText = "–";

    protected override void OnInitialized()
    {
        RefreshMetrics();
        RefreshEvents();
        InspectionLog.EventAdded += OnEventAdded;
        _ = PollMetricsAsync(_cts.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _alarmModule = await JS.InvokeAsync<IJSObjectReference>("import", _cts.Token, "./js/alarm.js");
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone before the module loaded.
        }
        catch (OperationCanceledException)
        {
            // Component disposed.
        }
        catch (ObjectDisposedException)
        {
            // Component disposed before the first render completed.
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Alarm sound module could not be loaded");
        }
    }

    // Raised on the detection thread, outside InspectionLog's lock. Must never throw.
    private void OnEventAdded(InspectionEvent e)
    {
        if (_disposed)
        {
            return;
        }

        if (e.Verdict is Verdict.Nok or Verdict.Danger)
        {
            lock (_pendingGate)
            {
                // Danger outranks Nok within one flush window.
                if (_pendingAlarm is null || e.Verdict == Verdict.Danger || _pendingAlarm.Verdict != Verdict.Danger)
                {
                    _pendingAlarm = e;
                }
            }
        }

        if (Interlocked.CompareExchange(ref _flushScheduled, 1, 0) == 0)
        {
            _ = FlushSoonAsync();
        }
    }

    private async Task FlushSoonAsync()
    {
        try
        {
            await Task.Delay(EventFlushDelay, Clock, _cts.Token);
            Interlocked.Exchange(ref _flushScheduled, 0);
            await InvokeAsync(FlushAsync);
        }
        catch (OperationCanceledException)
        {
            // Component disposed.
        }
        catch (ObjectDisposedException)
        {
            // Circuit or token source gone.
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Dashboard event refresh failed");
        }
    }

    // Runs on the renderer's sync context.
    private async Task FlushAsync()
    {
        if (_disposed)
        {
            return;
        }

        InspectionEvent? alarm;
        lock (_pendingGate)
        {
            alarm = _pendingAlarm;
            _pendingAlarm = null;
        }

        RefreshEvents();
        if (alarm is not null && (_alarm is null || alarm.Verdict == Verdict.Danger || _alarm.Verdict != Verdict.Danger))
        {
            ShowAlarm(alarm);
        }

        StateHasChanged();

        if (alarm is not null)
        {
            await BeepAsync(alarm.Verdict == Verdict.Danger ? "danger" : "nok");
        }
    }

    private void ShowAlarm(InspectionEvent e)
    {
        _alarm = e;
        int version = ++_alarmVersion;
        _ = HideAlarmLaterAsync(version);
    }

    private async Task HideAlarmLaterAsync(int version)
    {
        try
        {
            await Task.Delay(AlarmDuration, Clock, _cts.Token);
            await InvokeAsync(() =>
            {
                if (version == _alarmVersion && !_disposed)
                {
                    _alarm = null;
                    StateHasChanged();
                }
            });
        }
        catch (OperationCanceledException)
        {
            // Component disposed.
        }
        catch (ObjectDisposedException)
        {
            // Circuit or token source gone.
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Hiding the alarm banner failed");
        }
    }

    private async Task BeepAsync(string kind)
    {
        if (!_soundOn || _alarmModule is null)
        {
            return;
        }

        try
        {
            await _alarmModule.InvokeVoidAsync("beep", kind);
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone.
        }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "Alarm beep failed");
        }
    }

    private async Task ToggleSoundAsync()
    {
        if (_alarmModule is null)
        {
            return;
        }

        try
        {
            if (_soundOn)
            {
                await _alarmModule.InvokeVoidAsync("disable");
                _soundOn = false;
            }
            else
            {
                // Called from the click: the page has a user gesture, so the AudioContext may start.
                _soundOn = await _alarmModule.InvokeAsync<bool>("enable");
            }
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone.
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            // JS interop timeout or circuit gone; must not escape the click handler.
            _soundOn = false;
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Toggling the alarm sound failed");
            _soundOn = false;
        }
    }

    private async Task PollMetricsAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1), Clock);
        int ticks = 0;
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                bool refreshChart = ++ticks % ChartRefreshTicks == 0;
                await InvokeAsync(() =>
                {
                    RefreshMetrics();
                    if (refreshChart)
                    {
                        _buckets = InspectionLog.PerMinute(ChartMinutes);
                    }

                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Component disposed.
        }
        catch (ObjectDisposedException)
        {
            // Circuit gone; nothing to update.
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Dashboard metrics polling stopped unexpectedly");
        }
    }

    private void RefreshEvents()
    {
        (_counts, _recent) = InspectionLog.Snapshot(LogSize);
        _buckets = InspectionLog.PerMinute(ChartMinutes);
    }

    private void RefreshMetrics()
    {
        _sourceName = CameraStatus.SourceName;
        _connected = CameraStatus.IsConnected;
        _fps = CameraStatus.FpsIn;
        _lastError = CameraStatus.LastError;
        _procFps = Metrics.ProcessedFps;
        _inferenceMs = Metrics.InferenceMs;
        _isGpu = Metrics.Device.StartsWith("GPU", StringComparison.Ordinal);
        _deviceText = DeviceLabel(Metrics.Device, Metrics.Model);
        var all = Metrics.LastDetections;
        _detectionTotal = all.Count;
        // Ignored classes (e.g. person) are not shown in the list; they still count in the total.
        _detections = all
            .Where(d => d.Verdict != Verdict.Ignore)
            .OrderByDescending(d => d.Detection.Confidence)
            .Take(8)
            .ToList();

        var last = CameraStatus.LastFrameAt;
        if (last is null)
        {
            _lastFrameText = "–";
        }
        else
        {
            var ms = (long)Math.Max(0, (Clock.GetUtcNow() - last.Value).TotalMilliseconds);
            _lastFrameText = ms < 10_000 ? $"vor {ms} ms" : $"vor {ms / 1000} s";
        }
    }

    // New log entries carry the "fresh" class for a few seconds; the CSS animation plays once on insertion.
    private bool IsFresh(InspectionEvent e) => Clock.GetUtcNow() - e.Timestamp < FreshDuration;

    private static string AlarmText(InspectionEvent e) => e.Verdict == Verdict.Danger
        ? $"GEFAHR – {e.DisplayName} erkannt"
        : $"ALARM: n.i.O. – {e.DisplayName} erkannt";

    // Display-only: turns the backend strings into the short badge text, e.g. "GPU · yolo11m".
    private static string DeviceLabel(string device, string model)
    {
        if (string.IsNullOrWhiteSpace(device) || string.IsNullOrWhiteSpace(model))
        {
            return "–";
        }

        var kind = device.StartsWith("GPU", StringComparison.Ordinal) ? "GPU" : "CPU";
        var name = model.Replace(".onnx", string.Empty, StringComparison.OrdinalIgnoreCase);
        return $"{kind} · {name}";
    }

    private static string VerdictClass(Verdict v) => v switch
    {
        Verdict.Ok => "ok",
        Verdict.Nok => "nok",
        Verdict.Danger => "danger",
        Verdict.Ignore => "ignore",
        _ => "unknown",
    };

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        InspectionLog.EventAdded -= OnEventAdded;
        _cts.Cancel();
        _cts.Dispose();

        if (_alarmModule is not null)
        {
            try
            {
                await _alarmModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone; nothing to release on the client.
            }
        }
    }
}
