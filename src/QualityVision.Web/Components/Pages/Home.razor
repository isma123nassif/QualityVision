@page "/"
@using System.Globalization
@using QualityVision.Core.Detection
@using QualityVision.Core.Inspection
@using QualityVision.Core.Rules
@using QualityVision.Web.Pipeline
@implements IDisposable
@inject ICameraStatus CameraStatus
@inject IPipelineMetrics Metrics
@inject IInspectionLog InspectionLog
@inject TimeProvider Clock

<PageTitle>QualityVision – Prüfstation</PageTitle>

<header class="app-header">
    <h1>QualityVision</h1>
    <p class="subtitle">KI-gestützte Qualitätsprüfung in Echtzeit</p>
</header>

<main class="dash">
    <section class="live" aria-label="Livebild">
        <div class="live-frame">
            <img src="/stream" alt="Livebild der Prüfstation" />
        </div>

        <div class="counters" aria-label="Zähler">
            <div class="counter ok"><span class="label">i.O.</span><span class="value">@_counts.Ok</span></div>
            <div class="counter nok"><span class="label">n.i.O.</span><span class="value">@_counts.Nok</span></div>
            <div class="counter danger"><span class="label">Gefahr</span><span class="value">@_counts.Danger</span></div>
            <div class="counter unknown"><span class="label">Unbekannt</span><span class="value">@_counts.Unknown</span></div>
            <div class="counter rate"><span class="label">Ausschussquote</span><span class="value">@((_counts.ScrapRate * 100).ToString("0.0", De)) %</span><span class="sub">n.i.O. / (i.O. + n.i.O.)</span></div>
        </div>

        <h2 class="panel-title">Letzte Prüfungen</h2>
        @if (_recent.Count == 0)
        {
            <p class="muted recent-empty">Noch keine Prüfungen</p>
        }
        else
        {
            <ul class="recent-list">
                @foreach (var e in _recent)
                {
                    <li>
                        <span class="recent-time">@e.Timestamp.ToLocalTime().ToString("HH:mm:ss", De)</span>
                        <span class="recent-name">@e.DisplayName</span>
                        <span class="verdict @VerdictClass(e.Verdict)">@VerdictLabels.Get(e.Verdict)</span>
                        <span class="det-conf">@e.Confidence.ToString("P0", De)</span>
                    </li>
                }
            </ul>
        }
    </section>

    <aside class="status" aria-label="Kamerastatus">
        <h2>Kamerastatus</h2>

        <div class="tile">
            <span class="label">Quelle</span>
            <span class="value value-text">@_sourceName</span>
        </div>

        <div class="tile">
            <span class="label">Verbindung</span>
            @if (_connected)
            {
                <span class="value badge ok">● Verbunden</span>
            }
            else
            {
                <span class="value badge nok">● Getrennt</span>
            }
        </div>

        <div class="tile">
            <span class="label">Eingangs-FPS</span>
            <span class="value">@_fps.ToString("0.0", De)</span>
        </div>

        <div class="tile">
            <span class="label">Letztes Bild</span>
            <span class="value">@_lastFrameText</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(_lastError))
        {
            <p class="error-text">Fehler: @_lastError</p>
        }

        <h2 class="panel-title">Verarbeitung</h2>

        <div class="tile">
            <span class="label">Erkennung</span>
            <span class="device-badge @(_isGpu ? "gpu" : "cpu")">@_deviceText</span>
        </div>

        <div class="tile">
            <span class="label">Verarbeitung (FPS)</span>
            <span class="value">@_procFps.ToString("0.0", De)</span>
        </div>

        <div class="tile">
            <span class="label">Inferenz (ms)</span>
            <span class="value">@_inferenceMs.ToString("0.0", De)</span>
        </div>

        <div class="tile">
            <span class="label">Erkannt</span>
            <span class="value">@_detectionTotal</span>
        </div>

        <div class="tile">
            <span class="label">Erkannte Objekte</span>
            @if (_detections.Count == 0)
            {
                <span class="value-text muted">Keine Objekte</span>
            }
            else
            {
                <ul class="det-list">
                    @foreach (var d in _detections)
                    {
                        <li><span>@GermanLabels.Get(d.Detection.ClassName)</span><span class="verdict @VerdictClass(d.Verdict)">@VerdictLabels.Get(d.Verdict)</span><span class="det-conf">@d.Detection.Confidence.ToString("P0", De)</span></li>
                    }
                </ul>
            }
        </div>
    </aside>
</main>

@code {
    private readonly CancellationTokenSource _cts = new();
    private string _sourceName = "–";
    private bool _connected;
    private double _fps;
    private string _lastFrameText = "–";
    private string? _lastError;
    private double _procFps;
    private double _inferenceMs;
    private IReadOnlyList<ClassifiedDetection> _detections = [];
    private int _detectionTotal;
    private InspectionCounts _counts;
    private IReadOnlyList<InspectionEvent> _recent = [];
    private bool _isGpu;
    private string _deviceText = "–";
    private static readonly CultureInfo De = CultureInfo.GetCultureInfo("de-DE");

    protected override void OnInitialized()
    {
        Refresh();
        _ = PollAsync(_cts.Token);
    }

    private async Task PollAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1), Clock);
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                Refresh();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Component disposed.
        }
        catch (ObjectDisposedException)
        {
            // Circuit gone; nothing to update.
        }
    }

    private void Refresh()
    {
        _sourceName = CameraStatus.SourceName;
        _connected = CameraStatus.IsConnected;
        _fps = CameraStatus.FpsIn;
        _lastError = CameraStatus.LastError;
        _procFps = Metrics.ProcessedFps;
        _inferenceMs = Metrics.InferenceMs;
        _isGpu = Metrics.Device.StartsWith("GPU", StringComparison.Ordinal);
        _deviceText = DeviceLabel(Metrics.Device, Metrics.Model);
        var all = Metrics.LastDetections;
        _detectionTotal = all.Count;
        // Ignored classes (e.g. person) are not shown in the list; they still count in the total.
        _detections = all
            .Where(d => d.Verdict != Verdict.Ignore)
            .OrderByDescending(d => d.Detection.Confidence)
            .Take(8)
            .ToList();

        _counts = InspectionLog.Counts;
        _recent = InspectionLog.Recent(10);

        var last = CameraStatus.LastFrameAt;
        if (last is null)
        {
            _lastFrameText = "–";
        }
        else
        {
            var ms = (long)Math.Max(0, (Clock.GetUtcNow() - last.Value).TotalMilliseconds);
            _lastFrameText = ms < 10_000 ? $"vor {ms} ms" : $"vor {ms / 1000} s";
        }
    }

    // Display-only: turns the backend strings into the short badge text, e.g. "GPU · yolo11m".
    private static string DeviceLabel(string device, string model)
    {
        if (string.IsNullOrWhiteSpace(device) || string.IsNullOrWhiteSpace(model))
        {
            return "–";
        }

        var kind = device.StartsWith("GPU", StringComparison.Ordinal) ? "GPU" : "CPU";
        var name = model.Replace(".onnx", string.Empty, StringComparison.OrdinalIgnoreCase);
        return $"{kind} · {name}";
    }

    private static string VerdictClass(Verdict v) => v switch
    {
        Verdict.Ok => "ok",
        Verdict.Nok => "nok",
        Verdict.Danger => "danger",
        Verdict.Ignore => "ignore",
        _ => "unknown",
    };

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
