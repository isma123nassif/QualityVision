<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\QualityVision.Infrastructure\QualityVision.Infrastructure.csproj" />
    <ProjectReference Include="..\QualityVision.Core\QualityVision.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\models\yolo11n.onnx" Link="models\yolo11n.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\models\yolo11m.onnx" Link="models\yolo11m.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\models\yoloworld-qv.onnx" Condition="Exists('..\..\models\yoloworld-qv.onnx')" Link="models\yoloworld-qv.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hot-reloadable rules. At runtime the app reads the copy in the content root (the project folder under
         `dotnet run`), so editing src/QualityVision.Web/rules.json reloads live; the output copy is for publish.
         When published, the content root is the current working directory: start the app from the publish folder
         (or pass the contentRoot command-line argument), otherwise the required rules.json is not found. -->
    <Content Update="rules.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- ExcludeAssets does not flow to consuming projects, so it is repeated here: the CPU-only native
         libonnxruntime.so of Microsoft.ML.OnnxRuntime must not overwrite the GPU build (see ADR-004). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" ExcludeAssets="native;runtime" />
  </ItemGroup>

</Project>
